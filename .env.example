# Postgres connection string for the Payload database adapter — the Supabase dev project's
# Session pooler URI (URL-encode special characters in the password)
DATABASE_URI=postgres://user:password@localhost:5432/seoblog

# Random string used to sign Payload's tokens — generate with `openssl rand -base64 32`
PAYLOAD_SECRET=

# Cloudflare account ID, used to build the R2 S3 endpoint https://<id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Name of the R2 bucket media uploads are stored in
R2_BUCKET=
# R2 API token access key ID (read/write access to the bucket)
R2_ACCESS_KEY_ID=
# R2 API token secret access key
R2_SECRET_ACCESS_KEY=
# Public base URL media is served from, no trailing slash — e.g. https://media.example.com or the r2.dev URL
R2_PUBLIC_URL=

# Scheme for absolute public URLs built by src/lib/urls.ts — `http` in dev, `https` in prod
PUBLIC_URL_SCHEME=http
# Port appended to public URLs — `3000` in dev, empty in prod
PUBLIC_URL_PORT=3000

# Hostname the Payload admin, REST API, and draft preview are served from. Every other
# hostname is treated as a public blog domain. Dev: `localhost`; production: `admin.<yourdomain>`
ADMIN_HOSTNAME=localhost
# `development` | `staging` | `production`. Anything but `production` sends
# `X-Robots-Tag: noindex, nofollow` and a disallow-all robots.txt
SITE_ENV=development
# URLs per sitemap file before `sitemap.xml` becomes a sitemap index (protocol limit: 50000).
# Lower it locally to exercise the split.
SITEMAP_CHUNK_SIZE=45000

# Anthropic API key for article generation (Message Batches API) and keyword clustering
ANTHROPIC_API_KEY=
# Claude model used for generation — spec §3 chooses Sonnet 5
GENERATION_MODEL=claude-sonnet-5
# Effort for generation requests: low | medium | high | xhigh | max
GENERATION_EFFORT=medium
# Bearer secret cron routes require (`Authorization: Bearer <secret>`) — generate with `openssl rand -hex 32`.
# Use a different value per environment.
CRON_SECRET=
# Batch results imported per /api/cron/generation call, per batch. Lower it to exercise resumable imports.
IMPORT_CHUNK_SIZE=50

# Submit newly published URLs to IndexNow. Only takes effect together with SITE_ENV=production;
# anywhere else submissions are logged as a dry run. Leave false until phase 07 verifies it live.
INDEXNOW_ENABLED=false

# DataForSEO API login and API password (dashboard → API Access; the API password is not the account password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DataForSEO API base URL, no trailing slash and no /v3. Development uses the free sandbox (dummy data,
# no charge): https://sandbox.dataforseo.com. Live data and billing: https://api.dataforseo.com
DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com
